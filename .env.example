# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings -> API page. These three are the ONLY environment variables the app
# reads — pointing it at another Supabase project needs no code changes.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — safe in the browser bundle, RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SERVER ONLY, bypasses RLS. Never expose to the client,
# never commit.
SUPABASE_SERVICE_ROLE_KEY=
